<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Leantime Ticket Generator{% endblock %}</title>
        <style>
            body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 700px; margin: 2rem auto; padding: 0 1rem; color: #333; }
            h1 { color: #1a56db; }
            label { display: block; margin-top: 1rem; font-weight: 600; }
            input[type="text"], select, textarea { width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.85rem; box-sizing: border-box; font-family: inherit; }
            textarea { min-height: 5rem; resize: vertical; }
            .checkbox-list { max-height: 300px; overflow-y: auto; border: 1px solid #ccc; border-radius: 4px; padding: 0.5rem; }
            .checkbox-row { display: flex; align-items: center; gap: 0.35rem; margin: 0.25rem 0; }
            .checkbox-row label { display: inline; font-weight: normal; margin-top: 0; }
            button, input[type="submit"] { margin-top: 1.5rem; padding: 0.75rem 1.5rem; background: #1a56db; color: white; border: none; border-radius: 4px; font-size: 1rem; cursor: pointer; }
            button:hover, input[type="submit"]:hover { background: #1444b0; }
            .button-group { display: flex; gap: 1rem; margin-top: 2rem; }
            .btn { display: inline-block; padding: 1rem 2rem; background: #1a56db; color: white; text-decoration: none; border-radius: 4px; font-size: 1.1rem; text-align: center; }
            .btn:hover { background: #1444b0; }
            .success { background: #d4edda; border: 1px solid #c3e6cb; padding: 1rem; border-radius: 4px; margin: 0.5rem 0; }
            .error { background: #f8d7da; border: 1px solid #f5c6cb; padding: 1rem; border-radius: 4px; margin: 0.5rem 0; }
        </style>
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>

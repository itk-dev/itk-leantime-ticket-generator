{% extends 'base.html.twig' %}

{% block title %}Tickets Created{% endblock %}

{% block body %}
    <h1>Results for "{{ title }}"</h1>

    {% for result in results %}
        {% if result.success %}
            <div class="success">
                Ticket #{{ result.ticketId }} created in <strong>{{ result.projectName }}</strong>: {{ result.title }}
            </div>
        {% else %}
            <div class="error">
                Failed in <strong>{{ result.projectName }}</strong> ({{ result.title }}): {{ result.error }}
            </div>
        {% endif %}
    {% endfor %}

    <a href="{{ path('app_ticket_from_github') }}"><button type="button">Create more tickets</button></a>
    <a href="{{ path('app_home') }}"><button type="button" class="btn-back">Home</button></a>
{% endblock %}

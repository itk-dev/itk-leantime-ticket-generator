{% extends 'base.html.twig' %}

{% block title %}Across Projects{% endblock %}

{% block body %}
    <h1>Create Tickets Across Projects</h1>

    {% for message in app.flashes('error') %}
        <div class="error">{{ message }}</div>
    {% endfor %}

    {% if form is not null %}
        {{ form_start(form) }}
            <div>
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>

            <div>
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>

            <div>
                {{ form_label(form.projects) }}
                <div class="checkbox-list">
                    {% for child in form.projects %}
                        <div class="checkbox-row">
                            {{ form_widget(child) }}
                            {{ form_label(child) }}
                        </div>
                    {% endfor %}
                </div>
                {{ form_errors(form.projects) }}
            </div>

            <div>
                {{ form_label(form.due_date) }}
                {{ form_widget(form.due_date) }}
                {{ form_errors(form.due_date) }}
            </div>

            <div>
                {{ form_label(form.planned_hours) }}
                {{ form_widget(form.planned_hours) }}
                {{ form_errors(form.planned_hours) }}
            </div>

            <div id="manual-hours-wrapper" style="display: none;">
                {{ form_label(form.manual_hours) }}
                {{ form_widget(form.manual_hours) }}
                {{ form_errors(form.manual_hours) }}
            </div>

            <div>
                {{ form_label(form.tags) }}
                {{ form_widget(form.tags) }}
                {{ form_errors(form.tags) }}
            </div>

            <div>
                {{ form_label(form.milestone) }}
                {{ form_widget(form.milestone) }}
                {{ form_errors(form.milestone) }}
            </div>

            {{ form_widget(form.submit) }}
        {{ form_end(form) }}

        <script>
            const plannedSelect = document.getElementById('ticket_planned_hours');
            const manualWrapper = document.getElementById('manual-hours-wrapper');

            function toggleManual() {
                const selected = plannedSelect.options[plannedSelect.selectedIndex];
                const isManual = selected && selected.textContent.trim().toLowerCase().startsWith('manual');
                manualWrapper.style.display = isManual ? '' : 'none';
            }
            toggleManual();
            plannedSelect.addEventListener('change', toggleManual);
        </script>
    {% endif %}

    <a href="{{ path('app_home') }}"><button type="button" style="background: #666;">Back</button></a>
{% endblock %}
